{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "include": [
    "src/**/*.ts"
  ]
}